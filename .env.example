# URL pública (canonical, sitemap, Open Graph e JSON-LD).
# Na Vercel pode ficar vazia: o domínio de produção do projeto é usado automaticamente.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp comercial: 55 + DDD + número, só dígitos (ex.: 5516999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Google Analytics 4 instalado direto (ex.: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Tag Manager (Google Ads e Meta Pixel). Se usar GA4 dentro do GTM, deixe NEXT_PUBLIC_GA_ID vazio.
NEXT_PUBLIC_GTM_ID=

# Formulário de contato (EmailJS, chamado pelo servidor — nunca use NEXT_PUBLIC_ aqui)
# Dashboard EmailJS: Email Services (service ID), Email Templates (template ID) e Account > API Keys.
# Ative também Account > Security > "Allow EmailJS API for non-browser applications".
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Destinatário dos contatos (padrão: e-mail do site em src/config/site.ts)
CONTACT_TO=
