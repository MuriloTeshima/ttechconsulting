# Public URL (canonical, sitemap, Open Graph and JSON-LD).
# Can be empty on Vercel: the project's production domain is used automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Business WhatsApp: 55 + area code + number, digits only (e.g. 5516999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Google Analytics 4 installed directly (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Tag Manager (Google Ads and Meta Pixel). If you use GA4 inside GTM, leave NEXT_PUBLIC_GA_ID empty.
NEXT_PUBLIC_GTM_ID=

# Contact form (EmailJS, called from the server, so never use NEXT_PUBLIC_ here)
# EmailJS dashboard: Email Services (service ID), Email Templates (template ID) and Account > API Keys.
# Also turn on Account > Security > "Allow EmailJS API for non-browser applications".
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Who receives contact messages (default: the site email in src/config/site.ts)
CONTACT_TO=

# Payload CMS
# Local: the docker-compose Postgres (docker compose up -d). Production: Neon (Vercel → Storage),
# which creates DATABASE_URL automatically.
DATABASE_URL=postgres://ttech:ttech@localhost:5434/ttech_cms
# Payload secret (generate with: openssl rand -hex 32)
PAYLOAD_SECRET=
# Secret for the draft preview link (generate with: openssl rand -hex 24)
PREVIEW_SECRET=
# Vercel Blob (Vercel → Storage → Blob). Without it, images stay in the local /media folder.
BLOB_READ_WRITE_TOKEN=

# Cloudflare Turnstile (anti-spam for the contact form and quizzes). Empty turns the check off.
# Cloudflare → Turnstile → Add widget (Managed mode, domain ttechcs.com.br).
# For local testing, Cloudflare's test keys always pass:
#   site key 1x00000000000000000000AA · secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Panel emails (password reset) through Resend. Without the key, the email only shows in the console.
# Resend → Domains: verify ttechcs.com.br (DNS records on Vercel) → API Keys (Sending access).
RESEND_API_KEY=
# Sender (domain verified in Resend)
EMAIL_FROM=nao-responda@ttechcs.com.br
